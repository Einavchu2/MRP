# Copy this file to .env and fill in your token
# NEVER commit .env to git

DATABRICKS_TOKEN=your_token_here

# Data API (api/) — ORACLE_DWH connection, read by api/config.py
DB_SERVER=your_sql_server_host
DB_DWH_DATABASE=your_database_name
DB_DWH_UID=your_username
DB_DWH_PWD=your_password

# Streamlit side (src/db.py) — where to reach the API. Default is fine
# unless the API runs on a different host/port.
# MRP_API_URL=http://127.0.0.1:8502
