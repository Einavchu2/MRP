# Copy this file to ".env" in this same folder and fill in real values.
# NEVER commit monitoring\.env to git — it's already covered by .gitignore.
#
# Leaving SMTP_HOST at its placeholder value below means the monitor will
# skip email and fall back to writing monitoring\alerts\ALERT_<run>.html
# plus a Windows Event Log entry (Application log, source "MRP Daily
# Monitor") — so escalation still leaves a trace even before this is filled
# in, it just won't reach an inbox.

SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=alerts@yourcompany.com
SMTP_PASSWORD=changeme
SMTP_FROM=mrp-monitor@yourcompany.com
# Comma-separated — every address gets the full daily alert.
SMTP_TO=you@yourcompany.com
